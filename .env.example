# ==========================================
# DailyMed Labeling Image Query - Config
# ==========================================

# --- Data & Storage Paths (Inside Container) ---
DATA_DIR=/app/data
IMAGES_DIR=/app/data/images
DOWNLOADS_DIR=/app/data/downloads

# --- PostgreSQL + pgvector ---
POSTGRES_DB=labeling_db
POSTGRES_USER=labeling
POSTGRES_PASSWORD=labeling_pass
DATABASE_URL=postgresql://labeling:labeling_pass@postgres:5432/labeling_db

# --- Intranet vLLM (gemma-4-31b) ---
# OpenAI-compatible endpoint provided by your intranet vLLM server
VLLM_BASE_URL=http://192.168.1.100:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=gemma-4-31b
VLLM_TIMEOUT=60
VLLM_MAX_RETRIES=2
VLLM_TEMPERATURE=0.1
VLLM_QUERY_MAX_TOKENS=300
VLLM_CAPTION_MAX_TOKENS=150
VLLM_VERIFY_SSL=true
VLLM_ENABLED=true

# --- Local Embedding Model (CPU-only) ---
# Can be a HuggingFace repo ID or a local mounted path like /app/models/siglip-base-patch16-224
EMBEDDING_MODEL=google/siglip-base-patch16-224
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16

# --- DailyMed Sync Schedule ---
# Weekly schedule in UTC (default: Sunday 02:00 UTC)
SYNC_CRON_DAY_OF_WEEK=sun
SYNC_CRON_HOUR=2
SYNC_CRON_MINUTE=0
# Categories to sync: human_rx, human_otc (comma-separated)
DAILYMED_CATEGORIES=human_rx,human_otc
# Delete downloaded raw zip files after ingestion to save disk space
CLEANUP_DOWNLOADS=true
# Minimum image dimension (width or height) to filter out tiny icons/spacers
MIN_IMAGE_SIZE=64
# Optional: run VLM captioning during background ingestion (slower, set false for fast initial load)
INGEST_VLM_CAPTION=false

# --- Search Settings ---
SEARCH_CACHE_TTL_SECONDS=3600
SEARCH_MAX_RESULTS=90
PAGE_SIZE=9

# --- Admin Dashboard ---
# Optional: set a secret token to protect /api/admin/* endpoints
ADMIN_TOKEN=
